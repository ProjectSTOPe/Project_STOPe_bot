import sqlite3

# База данных классов (теперь это твой источник истины)
CLASSES_DATA = {
    "Ассасин": {"atk": 15, "dex": 20, "luck": 25, "hp": 100, "passive": "Крит. удар +8%"},
    "Авангард": {"atk": 10, "dex": 10, "luck": 10, "hp": 200, "passive": "Снижение урона -10%"},
    "Маг": {"atk": 25, "dex": 8, "luck": 15, "hp": 80, "passive": "+10% к урону, -5% защиты"},
    "Паладин": {"atk": 12, "dex": 8, "luck": 5, "hp": 250, "passive": "Лечение +5% за раунд"}
}

def get_db():
    return sqlite3.connect("game.db")

def init_db():
    conn = get_db()
    c = conn.cursor()
    # Убедись, что таблица содержит нужные колонки
    c.execute('''CREATE TABLE IF NOT EXISTS players 
                 (uid INTEGER PRIMARY KEY, name TEXT, lvl INTEGER, exp INTEGER, 
                  gold INTEGER, str INTEGER, dex INTEGER, luk INTEGER, vit INTEGER, class TEXT)''')
    conn.commit()
    conn.close()

def set_player_class(uid, class_name):
    if class_name not in CLASSES_DATA: return
    
    stats = CLASSES_DATA[class_name]
    conn = get_db()
    c = conn.cursor()
    c.execute("UPDATE players SET class = ?, str = ?, dex = ?, luk = ?, vit = ? WHERE uid = ?", 
              (class_name, stats['atk'], stats['dex'], stats['luck'], stats['hp'], uid))
    conn.commit()
    conn.close()

